{
  "name": "dsh-forge",
  "version": "0.2.0",
  "description": "DSH plugin factory — discover agentic repos, generate DSH plugins via LLM, validate, sandbox-test, install, activate, and package deterministically. Includes a DSH-adapted skill set for workflow discovery, compilation, brand identity, listing preparation, and reviewer evidence.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "dsh-forge contributors"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "docs",
    "submission",
    "assets",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "python3 skills/dsh-plugin-autopilot/scripts/validate_plugin.py . --json",
    "self-check": "python3 skills/dsh-plugin-autopilot/scripts/validate_plugin.py . --json"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "npm@10.9.9"
}
